# ====================================================================
# R Corporation AI Customer Support SaaS - Environment Configuration
# ====================================================================

# Django Backend Settings
DJANGO_SECRET_KEY=rcorp-production-super-secret-key-replace-in-prod
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# Database Engine: 'sqlite' or 'mysql'
DATABASE_ENGINE=sqlite
DB_NAME=rcorp_support_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# AI Engine / OpenAI (Optional - system includes high-fidelity local RAG and emotion engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_DAYS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend API URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api
